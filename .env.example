# ============================================
# Discord Impersonation Chat Bot - 設定ファイル
# ============================================

# ---------- 必須設定 ----------
# Discord Bot のトークン (Bot を動かすために絶対必要)
# Discord Developer Portal の "Bot" セクションから取得できます
TOKEN=your_bot_token_here

# ---------- オプション設定 ----------
# ログ送信用 Webhook URL (任意)
# 設定すると、なりすまし実行時に詳細なログが Embed で送信されます
# 空のままにするとログ機能は無効になります
LOG_WEBHOOK_URL=

# ログ送信の有効/無効 (true / false)
# LOG_WEBHOOK_URL が設定されていても、ここが false なら送信しません
WEBHOOK_ENABLED=false

# Bot の応答言語 (ja / en)
# 日本語環境なら "ja"、英語環境なら "en" を指定
LANG=ja

# ---------- 補足 ----------
# このファイルを .env にリネームして、各値を実際のものに置き換えてください
# .env は .gitignore に追加して、トークンを公開しないよう注意してください