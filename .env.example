# ============================================
# Discord Impersonation Chat Bot - 設定ファイル
# ============================================

# ---------- 必須設定 ----------
# Discord Bot のトークン (DISCORD_TOKEN または TOKEN)
DISCORD_TOKEN=your_bot_token_here

# ---------- オプション設定 ----------
# 全体管理者用 ログ Webhook URL (任意)
# 設定すると、全サーバーの /chat 実行ログがこのWebhookにも転送されます
GLOBAL_LOG_WEBHOOK_URL=

# 内部 Web API ポート (デフォルト: 8088)
API_PORT=8088

# データベースファイルパス (デフォルト: settings.db)
DB_PATH=settings.db

# Bot の応答言語 (ja / en)
LANG=ja